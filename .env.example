# ==============================================================================
# AMR Fleet Management - Backend Environment Variables Template
# ==============================================================================
# Copy this file to '.env' in the root directory and fill in your values.
#
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Network Configuration
# ------------------------------------------------------------------------------
# Server host binding (defaults to 0.0.0.0 for universal access)
HOST=0.0.0.0

# HTTP & WebSocket port (automatically assigned on Render/Railway, defaults to 8000 locally)
PORT=8000

# Decentralized P2P UDP Beacon & Gossip Port (defaults to 9999)
BEACON_PORT=9999

# UDP Broadcast Target Address (e.g., 255.255.255.255 or subnet broadcast 192.168.1.255)
BROADCAST_ADDRESS=255.255.255.255

# Multi-Laptop / P2P Mesh Direct Peer IPs (optional comma-separated list for strict Wi-Fi routers)
# Example: PEER_IPS=192.168.1.50,192.168.1.51
PEER_IPS=

# ------------------------------------------------------------------------------
# 2. Database & User Persistence (Optional)
# ------------------------------------------------------------------------------
# If omitted, the server automatically uses seamless in-memory storage for local dev / demo.
# Obtain these from your Supabase Dashboard: Project Settings -> API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. Client & Bulk Generator Script Options
# ------------------------------------------------------------------------------
# Target Backend API URL used by CLI scripts (e.g. inject_bulk_tasks.py)
SERVER_URL=http://localhost:8000
