# ==============================================================================
# AMR Fleet Viewer - Frontend Environment Variables Template
# ==============================================================================
# Copy this file to '.env' or '.env.local' inside the 'viewer/' directory.
#
#   cp .env.example .env
# ==============================================================================

# Backend API & WebSocket Endpoint Base URL
# - In Local Development with Vite Proxy:
#   Leave blank or set to http://localhost:8000
# - In Cloud Production (e.g. Vercel / Netlify):
#   Set to your live Render backend URL (e.g. https://your-backend.onrender.com)
VITE_API_URL=http://localhost:8000

# Backend Dev Server Port (Optional override for local Vite dev server proxy)
VITE_BACKEND_PORT=8000
